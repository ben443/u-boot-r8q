# Samsung Galaxy S20 FE (R8Q) - select the upstream R8Q devicetree as the
# U-Boot control DTB. Use together with qcom_defconfig, qcom-phone.config
# and samsung-sm8250.config.
CONFIG_DEFAULT_DEVICE_TREE="qcom/sm8250-samsung-r8q"
CONFIG_ENV_DEFAULT_ENV_TEXT_FILE="board/qualcomm/samsung-r8q.env"
CONFIG_BOOTSTD_FULL=y
CONFIG_CMD_BOOTFLOW=y
CONFIG_BOOTMETH_EXTLINUX=y
