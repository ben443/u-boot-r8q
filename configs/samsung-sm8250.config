CONFIG_TEXT_BASE=0x91000000

# Ensure that EFI capsule updates are enabled
CONFIG_EFI_RUNTIME_UPDATE_CAPSULE=y
CONFIG_EFI_CAPSULE_ON_DISK=y
CONFIG_EFI_CAPSULE_ON_DISK_EARLY=y
CONFIG_EFI_CAPSULE_FIRMWARE_RAW=y

# Useful for debugging SMBIOS data
CONFIG_CMD_SMBIOS=y
CONFIG_BLKMAP=y
CONFIG_CMD_BLKMAP=y
CONFIG_CMD_UFETCH=y

# Set the namespace GUID so that there are no conflicts with U-Boot 
# image GUIDs on devices that use dynamic UUIDs for capsule updates.
# This namespace GUID identifies tauchgang community builds of U-Boot!
CONFIG_EFI_CAPSULE_NAMESPACE_GUID="a39b9978-2477-4522-9488-4c918c991327"

CONFIG_FASTBOOT_FLASH=y
CONFIG_FASTBOOT_FLASH_BLOCK=y
CONFIG_FASTBOOT_FLASH_BLOCK_INTERFACE_NAME="scsi"
CONFIG_FASTBOOT_FLASH_BLOCK_DEVICE_ID=0

# CONFIG_FASTBOOT_FLASH_MMC is not set
# CONFIG_FASTBOOT_MMC_USER_SUPPORT is not set
# CONFIG_FASTBOOT_MMC_BOOT_SUPPORT is not set

# Mainline Linux kernel boot support
CONFIG_BOOTM_LINUX=y
CONFIG_BOOTM_VXWORKS=y
CONFIG_FDT_IN_MEMORY=y
CONFIG_CMD_BOOTI=y
CONFIG_OF_LIBFDT=y
CONFIG_CMD_FDT=y

# Distroboot support for standard Linux partitions
CONFIG_DISTRO_DEFAULTS=y
CONFIG_BOOT_DEFAULTS=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_EXT2=y
CONFIG_CMD_FAT=y
CONFIG_FS_FAT=y
CONFIG_FS_EXT4=y

# Kernel and ramdisk load addresses for ARM64
CONFIG_SYS_LOAD_ADDR=0x40000000
CONFIG_INITRD_TAG=y
CONFIG_SETUP_MEMORY_TAGS=y

# Console and serial output for kernel handoff
CONFIG_CONSOLE_MUX=y
CONFIG_SYS_CONSOLE_IS_IN_ENV=y
CONFIG_LOGLEVEL=4
