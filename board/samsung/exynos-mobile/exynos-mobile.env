stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

# NetHunter Pro kernel boot arguments
# Required for mainline Linux kernel compatibility
kernel_addr_r=0x40000000
fdt_addr_r=0x43000000
ramdisk_addr_r=0x44000000
scriptaddr=0x45000000
pxefile_addr_r=0x46000000
fdt_high=0xffffffffffffffff
initrd_high=0xffffffffffffffff

# Default bootargs for mainline kernel
# Includes UFS root device, console output, and SELinux configuration
bootargs=root=/dev/sda1 ro console=ttyMSM0,115200 console=tty0 androidboot.selinux=permissive debug

blkmapcmd=blkmap create root;
	  blkmap map root 0 ${blkmap_size_r} linear ${blkmap_blk_ifname} ${blkmap_blk_dev} ${blkmap_blk_nr}

preboot=run blkmapcmd

bootdelay=2

# Boot sequence: try Linux kernel first, then EFI, then menu
bootcmd=run linux_boot; echo "Linux boot failed"; bootefi bootmgr; echo "EFI boot failed"; pause; bootmenu

# Load kernel from UFS partition disk 3 (boot partition)
load_kernel=scsi scan; load scsi 0:1 ${kernel_addr_r} /Image
load_fdt=load scsi 0:1 ${fdt_addr_r} /sm8250-samsung-r8q.dtb

# Combined Linux boot command with kernel, DTB, and optional ramdisk
linux_boot=run load_kernel load_fdt; booti ${kernel_addr_r} - ${fdt_addr_r}

# Fastboot kernel boot support (for quick kernel iteration)
# Download kernel to memory, then boot directly
fastboot_kernel_boot=fastboot; booti ${kernel_addr_r} ${ramdisk_addr_r} ${fdt_addr_r}

fastbootcmd=echo "Fastboot Mode - Download kernel with 'fastboot download kernel.img', then run fastboot_kernel_boot or power cycle";
	fastboot -l 0x90000000 usb 0

# Distroboot configuration for standard Linux boot
distro_bootcmd=run boot_net_usb_start; run boot_script_usb; run boot_scsi

bootmenu_0=Boot Linux Kernel (UFS)=run linux_boot
bootmenu_1=Boot via Fastboot (for development)=run fastbootcmd; run fastboot_kernel_boot
bootmenu_2=Continue Boot (EFI)=bootefi bootmgr
bootmenu_3=UEFI Maintenance Menu=eficonfig
bootmenu_4=Reboot=reset
bootmenu_5=Power Off=poweroff

button_cmd_0_name=Volume Down Key
button_cmd_0=bootmenu
