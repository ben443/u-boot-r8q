# SPDX-License-Identifier: GPL-2.0+

bootdelay=0
bootretry=1
stdin=serial,button-kbd
stdout=serial,vidconsole
stderr=serial,vidconsole

# Scan UFS and USB media before standard boot looks for OS bootflows.
preboot=scsi scan; usb start

fastboot=fastboot -l $fastboot_addr_r usb 0

# Prefer distro-provided extlinux or EFI removable-media boot entries.
# Fall back to the EFI boot manager and then the recovery menu.
bootcmd=run r8q_boot
r8q_boot=bootflow scan -G -lb; echo "No extlinux or EFI removable-media bootflow succeeded"; bootefi bootmgr; echo "UEFI boot manager did not start an OS"; run menucmd

serial_gadget=setenv stdin serial,button-kbd,usbacm; \
	setenv stdout serial,vidconsole,usbacm; \
	setenv stderr serial,vidconsole,usbacm; \
	setenv bootretry -1; \
	echo Enabled U-Boot console serial gadget

menucmd=setenv bootcmd run menucmd; bootmenu -1
bootmenu_0=Boot from available media=run r8q_boot
bootmenu_1=Boot UEFI boot manager=bootefi bootmgr
bootmenu_2=Enable USB serial console=run serial_gadget
bootmenu_3=Enable USB mass storage=echo "Press any key to exit UMS mode"; ums 0 scsi 0
bootmenu_4=Enable fastboot mode=echo "Press any key to exit fastboot mode"; run fastboot
bootmenu_5=Drop to U-Boot shell=setenv bootretry -1
bootmenu_6=Reset device=reset
bootmenu_7=Power off=poweroff

# Hold Volume Down while U-Boot starts to open the recovery menu.
button_cmd_0_name=Volume Down
button_cmd_0=run menucmd
